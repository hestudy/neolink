# 测试环境变量 - 仅用于测试，不包含敏感信息
NODE_ENV=test

# 数据库配置 - 测试环境
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neolink_test
POSTGRES_DB=neolink_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis 配置 - 测试环境
REDIS_URL=redis://localhost:6379

# API 配置
API_PORT=8080
API_HOST=localhost

# Web 配置
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=test-nextauth-secret

# JWT 密钥 - 仅测试使用
JWT_SECRET=test-jwt-secret-key-for-testing-only
CSRF_SECRET=test-csrf-secret-key-for-testing-only

# AI 服务配置 - 测试环境（使用mock）
OPENAI_API_KEY=test-openai-key
OPENAI_MODEL=gpt-3.5-turbo

# 禁用外部服务
ENABLE_EXTERNAL_SERVICES=false
ENABLE_SENTRY=false
ENABLE_ANALYTICS=false

# 日志配置
LOG_LEVEL=error
DISABLE_CONSOLE_LOG=true